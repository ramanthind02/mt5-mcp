# Copy to %USERPROFILE%\.mt5-mcp\secrets.env
# Variable name is the terminal id, uppercased, with non-letters turned into
# underscores, then _PASSWORD. darwinex-demo -> DARWINEX_DEMO_PASSWORD.
# The agent never receives these values. Leave a line out to require a manual login.

DARWINEX_DEMO_PASSWORD=replace-me
DARWINEX_LIVE_PASSWORD=replace-me
